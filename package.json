{
  "name": "party-te",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:ai": "node --experimental-strip-types --env-file-if-exists=.env.local --test --test-concurrency=1 tests/ai-live.ts",
    "test:e2e": "playwright test",
    "test:ai:e2e": "AI_E2E=1 playwright test --grep @ai",
    "test:all": "npm test && npm run test:e2e && npm run test:ai && npm run test:ai:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "better-sqlite3": "^12.11.1",
    "next": "16.2.10",
    "openai": "^6.48.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5"
  }
}
