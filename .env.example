# Anthropic API key — powers chat, extraction, generation (default model
# claude-sonnet-5). Without it the app still runs; AI endpoints return 503.
ANTHROPIC_API_KEY=
# Moonshot key — .docx/.doc text extraction (file-extract) and the optional
# Kimi alternates via AI_MODEL=kimi-k3 / AI_MODEL=kimi-k2.6.
MOONSHOT_API_KEY=
